@app.route("/api/v1/health")
def health():
    return jsonify({"status":"ok","version":"11.5-loading-fixed","jobs":len(JOBS)})

@app.route("/api/v1/jobs")
def jobs():
    cat = request.args.get("category","all")
    q = request.args.get("search","").lower()
    res = JOBS
    if cat!="all":
        res = [j for j in res if j["k"]==cat]
    if q:
        res = [j for j in res if q in j["t"].lower()]
    return jsonify({"count":len(res),"jobs":res})

